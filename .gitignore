.DS_Store
*.pyc
__pycache__/
.ruff_cache/
.pytest_cache/
.venv/

# mypy
.mypy_cache/

# Ignore notebooks and notebook checkpoints
# If we want to actually allow notebooks in the future, we can make this specific to checkpoints
*.ipynb

# Ignore files we don't want to commit
*.parquet
*.eps
*.pdf
*.csv
*.xlsx
*.xls
*.txt
*.tmp
*.env
*.png
*.mat
*.pkl
*.zip
*_metadata.json
*_diffs.yaml
!bedrock/utils/**/*.csv
# asets stands for activity sets
!bedrock/extract/**/*_asets.csv
!bedrock/extract/external_data/*.csv
# Waste disaggregation weight fixtures (small; required for CI tests)
!bedrock/extract/disaggregation/waste_disagg_inputs/WasteDisaggregationDetail2017_*.csv
# Electricity disagg diagnostics local Excel exports (download from Sheets; keep dir via .gitkeep)
bedrock/analysis/electricity/current/diagnostics/local_data/*
!bedrock/analysis/electricity/current/diagnostics/local_data/.gitkeep

# Ignore JetBrains IDE project files
.idea/

# Ignore Cursor files
.cursor/
.cursorrules
.claude/plans/
scratch/

# Ignore VS Code files
.vscode/

# Ignore analysis output
bedrock/analysis/**/output/
# Original electricity-disagg implementation freeze (must be committed)
!bedrock/analysis/electricity/historical/original_elec_disagg_implementation/output/
!bedrock/analysis/electricity/historical/original_elec_disagg_implementation/output/**
!bedrock/analysis/electricity/historical/original_elec_disagg_implementation/output/**/*.parquet
!bedrock/analysis/electricity/historical/original_elec_disagg_implementation/output/**/*.json
# Pre-MECS Industrial-weight freeze (EIA G/T/D mixed units + dollar manufacturing)
!bedrock/analysis/electricity/historical/pre_mecs_industrial_weights/output/
!bedrock/analysis/electricity/historical/pre_mecs_industrial_weights/output/**
!bedrock/analysis/electricity/historical/pre_mecs_industrial_weights/output/**/*.parquet
!bedrock/analysis/electricity/historical/pre_mecs_industrial_weights/output/**/*.json
